              "pm.test('DTO de cliente sin entidades asociadas', function () { pm.expect(pm.response.json()).to.have.all.keys([\"id\",\"nombre\",\"apellido\",\"cedula\",\"telefono\",\"correo\"]); });",
              "pm.test('Cliente creado con datos enviados', function () { const datos=pm.response.json(); pm.expect(datos.correo).to.eql(pm.collectionVariables.get('pruebaCorreo')); pm.expect(datos.id).to.be.a('number').above(0); pm.collectionVariables.set('pruebaClienteId', datos.id); });"
            ]
