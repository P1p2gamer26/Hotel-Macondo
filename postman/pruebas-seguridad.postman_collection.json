{
  "info": {
    "name": "Hotel Macondo - Pruebas de seguridad inicial y DTO",
    "description": "Ejecutar completa, en orden, contra perfil test con datos iniciales. Solo usa endpoints existentes. Verifica registro con contraseña recibida, login, DTOs, cambio de clave, CRUD de operador y CORS. No verifica JWT ni autorización por roles: corresponden a la siguiente etapa. Crea registros con sufijo único y los elimina al terminar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('No devuelve error interno', function () { pm.expect(pm.response.code).to.be.below(500); });",
          "pm.test('La respuesta no expone contrasenas', function () {",
          "  if (!pm.response.text() || !(pm.response.headers.get('Content-Type') || '').includes('application/json')) return;",
          "  function revisar(valor) {",
          "    if (!valor || typeof valor !== 'object') return;",
          "    Object.keys(valor).forEach(function (clave) {",
          "      pm.expect(clave.toLowerCase()).not.to.be.oneOf(['contrasena', 'contraseña', 'password']);",
          "      revisar(valor[clave]);",
          "    });",
          "  }",
          "  revisar(pm.response.json());",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Consultar habitaciones e iniciar datos de prueba",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/habitacion"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const sufijo = String(Date.now());",
              "pm.collectionVariables.set('pruebaSufijo', sufijo);",
              "pm.collectionVariables.set('pruebaCedula', sufijo);",
              "pm.collectionVariables.set('pruebaCorreo', 'laura.' + sufijo + '@macondo.com');",
              "pm.collectionVariables.set('pruebaContrasena', 'ClaveElegida-' + sufijo);",
              "pm.collectionVariables.set('pruebaContrasenaNueva', 'NuevaClave-' + sufijo);",
              "pm.collectionVariables.unset('pruebaClienteId');",
              "pm.collectionVariables.unset('pruebaOperadorId');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Listado de habitaciones', function () { pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty; pm.response.json().forEach(function (h) { pm.expect(h).not.to.have.property('reservas'); }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Login administrador inicial",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"admin@macondo.com\",\n  \"contrasena\": \"admin\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('DTO de login y rol', function () { const datos=pm.response.json(); pm.expect(datos).to.have.all.keys('id','correo','rol','roles','cliente'); pm.expect(datos.rol).to.eql('ADMINISTRADOR'); pm.expect(datos.roles).to.include('ADMINISTRADOR'); });"
            ]
          }
        }
      ]
    },
